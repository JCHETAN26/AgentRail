# AgentRail local configuration.
#
# Copy to `.env` (`make bootstrap` does this for you) and adjust as needed.
# Every value here is a safe local default. This file must never contain a
# credential that is valid anywhere outside your machine.

# --- Runtime -----------------------------------------------------------------
AGENTRAIL_ENVIRONMENT=local
AGENTRAIL_LOG_LEVEL=INFO
AGENTRAIL_SHUTDOWN_GRACE_SECONDS=15

# --- PostgreSQL (authoritative state) ----------------------------------------
# Matches infra/compose/docker-compose.yml. The password is a local-only value.
AGENTRAIL_DATABASE_URL=postgresql+psycopg://agentrail:agentrail_local_dev@localhost:5433/agentrail

# --- Redis (task delivery only, never authoritative) --------------------------
AGENTRAIL_REDIS_URL=redis://localhost:6381/0
AGENTRAIL_JOB_QUEUE_KEY=agentrail:jobs:pending

# --- CloudOps sandbox ---------------------------------------------------------
AGENTRAIL_SANDBOX_BASE_URL=http://localhost:8100

# --- Web app ------------------------------------------------------------------
# Read by apps/web at build and run time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Docker Compose host ports ------------------------------------------------
# Overridable so the stack can coexist with other local projects.
AGENTRAIL_POSTGRES_PORT=5433
AGENTRAIL_REDIS_PORT=6381
AGENTRAIL_MINIO_PORT=9002
AGENTRAIL_MINIO_CONSOLE_PORT=9003
AGENTRAIL_API_PORT=8000
AGENTRAIL_SANDBOX_PORT=8100
AGENTRAIL_WORKER_HEALTH_PORT=8200

# --- Integration tests --------------------------------------------------------
# Set to 1 in CI so that a missing dependency fails the suite instead of
# silently skipping it.
AGENTRAIL_REQUIRE_INTEGRATION=0

# No model-provider key is required. The Phase 0 path is fully deterministic.
