{
  "name": "@agentrail/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/generated/api.ts",
    "check": "node ./scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
